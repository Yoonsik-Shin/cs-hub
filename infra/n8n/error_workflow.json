        "name": "Error Trigger"
      },
      {
        "parameters": {
          "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst lastAlertTime = staticData.lastAlertTime || 0;\nconst lastError = staticData.lastError || \"\";\nconst currentError = $json.execution.error.message;\n\nlet shouldSend = true;\nif (currentError === lastError && (now - lastAlertTime) < 30 * 60 * 1000) {\n  shouldSend = false;\n} else {\n  staticData.lastAlertTime = now;\n  staticData.lastError = currentError;\n}\n\nreturn [{\n  json: {\n    shouldSend,\n    workflow: $json.workflow,\n    node: $json.node,\n    execution: $json.execution\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
