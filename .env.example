# Database
DB_URL=jdbc:postgresql://postgres-db:5432/cs_database
DB_USERNAME=myuser
DB_PASSWORD=mypassword

# MinIO / S3 Config
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=cs-application
S3_REGION=ap-northeast-2
S3_EXTERNAL_URL=http://localhost:8888/attachments

# Naver Cafe Session Renew Trigger URL
NAVER_CAFE_SESSION_ID=9f2b4d68-4d2c-4db6-a9ec-285809470036
NAVER_SESSION_RENEW_TRIGGER_URL=http://n8n:5678/webhook/naver-session-refreshed

# API Tokens
INTERNAL_API_TOKEN=replace_with_internal_api_token
NAVER_SESSION_SECRET=change_me_32_byte_secret_value!!
PII_ENCRYPTION_SECRET=change_me_32_byte_secret_value!!

# N8N Public Webhook URL (Optional, set if utilizing external integrations)
# WEBHOOK_URL=http://localhost:5678/

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
# GRAFANA_ROOT_URL: 로컬(localhost) 환경에서는 주석 처리하거나 생략 가능하며, 외부 서버 배포 시 실제 도메인 주소로 수정해야 합니다.
GRAFANA_ROOT_URL=http://localhost:8888/grafana/

# Slack
SLACK_CHANNEL_ID=your_slack_channel_id_here
